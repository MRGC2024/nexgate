# NEXGATE Backend - Variáveis de ambiente
# Copie para .env e ajuste

NODE_ENV=development
PORT=4000

# Banco
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=nexgate
DATABASE_PASSWORD=nexgate_secret
DATABASE_NAME=nexgate

# Redis (fila webhooks)
REDIS_URL=redis://localhost:6379

# JWT (painel)
JWT_SECRET=altere-em-producao-jwt-secret-min-32-chars
JWT_EXPIRES_IN=1h

# Criptografia de credenciais dos conectores
MASTER_KEY_ENCRYPTION=nexgate-master-key-32-bytes!!

# Assinatura de webhooks (HMAC)
WEBHOOK_SIGNING_SECRET=nexgate-webhook-secret-change-in-prod

# CORS (origens permitidas, separadas por vírgula)
CORS_ORIGINS=http://localhost:3000
